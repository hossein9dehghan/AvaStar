{
  "name": "Avastar UI",
  "version": "3.1.0",
  "brand": {
    "blue": "#2D56C8",
    "navy": "#172B64",
    "orange": "#F7751D"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "input": "0.75rem",
    "card": "1.25rem",
    "dialog": "1.75rem",
    "pill": "999px"
  },
  "control": {
    "sm": "44px",
    "md": "48px",
    "lg": "56px"
  },
  "motion": {
    "fast": "120ms",
    "base": "240ms",
    "expressive": "400ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "response": "0.4",
    "damping": "1"
  },
  "layer": {
    "background": 0,
    "content": 3,
    "navigation": 30,
    "overlay": 50,
    "notification": 100
  },
  "layout": {
    "mobileBreakpoint": 760,
    "compactBreakpoint": 1150,
    "columnsDesktop": 12,
    "columnsMobile": 4,
    "maxContentWidth": 1240,
    "gutterDesktop": "2rem",
    "gutterMobile": "1rem",
    "sidebarWidth": "16rem",
    "readingWidth": "68ch",
    "workspaceWidth": "100%",
    "documentationBreakpoint": 960
  },
  "typography": {
    "family": "Peyda, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
    "weights": [
      {
        "name": "Light",
        "value": 300,
        "file": "Peyda-Light.woff"
      },
      {
        "name": "Regular",
        "value": 400,
        "file": "Peyda-Regular.woff"
      },
      {
        "name": "Medium",
        "value": 500,
        "file": "Peyda-Medium.woff"
      },
      {
        "name": "SemiBold",
        "value": 600,
        "file": "Peyda-SemiBold.woff"
      },
      {
        "name": "Bold",
        "value": 700,
        "file": "Peyda-Bold.woff"
      }
    ],
    "scale": [
      {
        "role": "Display",
        "size": "clamp(3.75rem,5.6vw,5.75rem)",
        "mobile": "clamp(2.5rem,10.4vw,3.5625rem)",
        "weight": 600,
        "lineHeight": 1.36
      },
      {
        "role": "Heading",
        "size": "3rem",
        "mobile": "1.9375rem",
        "weight": 500,
        "lineHeight": 1.6
      },
      {
        "role": "Title",
        "size": "1.5rem",
        "mobile": "1.4375rem",
        "weight": 500,
        "lineHeight": 1.65
      },
      {
        "role": "Body",
        "size": "1.125rem",
        "mobile": "1rem",
        "weight": 400,
        "lineHeight": 1.95
      },
      {
        "role": "Label",
        "size": "1rem",
        "mobile": "0.9375rem",
        "weight": 500,
        "lineHeight": 1.75
      },
      {
        "role": "Caption",
        "size": "0.875rem",
        "mobile": "0.8125rem",
        "weight": 400,
        "lineHeight": 1.85
      },
      {
        "role": "Meta",
        "size": "0.75rem",
        "mobile": "0.75rem",
        "weight": 400,
        "lineHeight": 1.65
      }
    ]
  },
  "themes": {
